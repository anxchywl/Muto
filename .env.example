# copy this file to .env for local development
#
# Flutter reads the first section at build time:
#   cd muto_app && flutter run --dart-define-from-file=../.env
# Docker Compose and the backend read the remaining values at runtime:
#   docker compose -f docker/docker-compose.yml up --build
#
# This file contains local-only placeholders. Never put real credentials here.

# ── flutter host ─────────────────────────────────────────────────────
# The standalone host is for development. ENABLE_DEV_ACCESS is effective only
# in a debug build; a release build still refuses to open without a real host.
ENABLE_DEV_ACCESS=true
MUTO_BACKEND=remote
MUTO_API_BASE_URL=http://127.0.0.1:8000
MUTO_ACCESS_TOKEN=muto-local-only
MUTO_ADMIN_ACCESS_TOKEN=muto-admin-local-only

# ── backend ──────────────────────────────────────────────────────────
APP_ENV=development
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://muto:muto_dev@localhost:54321/muto
POSTGRES_PASSWORD=muto_dev

# Must be at least 32 characters. Replace it outside local development.
CURSOR_SECRET=muto-local-cursor-secret-change-before-production

# The development adapter accepts only the matching local token values. It is
# rejected when APP_ENV=production.
AUTH_ADAPTER=development
DEVELOPMENT_AUTH_TOKEN=muto-local-only
DEVELOPMENT_ADMIN_AUTH_TOKEN=muto-admin-local-only
DEVELOPMENT_AUTH_SUBJECT=student-a
DEVELOPMENT_AUTH_DISPLAY_NAME=Development Student
DEVELOPMENT_AUTH_VERIFIED=true
DEVELOPMENT_ADMIN_AUTH_SUBJECT=operator-a
DEVELOPMENT_ADMIN_AUTH_DISPLAY_NAME=Development Operator

# ── api behavior ─────────────────────────────────────────────────────
API_DOCS_ENABLED=true
CORS_ALLOWED_ORIGINS=
REQUEST_BODY_MAX_BYTES=150000
DEFAULT_PAGE_SIZE=8
MAXIMUM_PAGE_SIZE=50
IDEMPOTENCY_TTL_HOURS=24

# ── reports and uploads ──────────────────────────────────────────────
REPORT_BURST_LIMIT=5
REPORT_WINDOW_SECONDS=600
REPORT_RETENTION_DAYS=365
IMAGE_UPLOAD_TTL_MINUTES=60
IMAGE_UPLOAD_BURST_LIMIT=30
IMAGE_UPLOAD_WINDOW_SECONDS=3600
EXPIRED_UPLOAD_RETENTION_DAYS=30
STORAGE_ORPHAN_GRACE_HOURS=24

# ── local image storage ──────────────────────────────────────────────
# Docker stores files in its private volume. This path is used when running
# the backend directly on the host.
STORAGE_ADAPTER=local
IMAGE_STORAGE_ROOT=.local/image-storage

# ── private s3-compatible storage ───────────────────────────────────
# Leave empty for local storage. Production requires HTTPS, a private bucket,
# and credentials supplied through a secret manager or deployment environment.
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

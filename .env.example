# Copy to .env and pass it to Flutter:
#
#   cd muto_app && flutter run --dart-define-from-file=../.env
#
# These are compile-time defines, not process environment variables. Nothing in
# this repository reads the environment at runtime.
#
# .env is git-ignored. It holds no secret today, and none should ever be added
# to it: this build has no server, no account system and no credential.

# Lets the standalone development host open the marketplace with a placeholder
# session that authorises nothing.
#
# Only ever weakens a debug build. The gate is `kDebugMode && ENABLE_DEV_ACCESS`,
# so a release build refuses to open even with this set to true.
ENABLE_DEV_ACCESS=true

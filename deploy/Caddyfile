{
	email {$ACME_EMAIL}
	admin off
}

{$MUTO_API_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 6MB
	}
	reverse_proxy backend:8000
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
	log {
		output stdout
		format json
	}
}

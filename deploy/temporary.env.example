# temporary remote development only; never reuse these placeholder values
APP_ENV=development
POSTGRES_DB=muto
POSTGRES_USER=muto
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://muto:URL_ENCODED_PASSWORD@postgres:5432/muto
CURSOR_SECRET=
AUTH_ADAPTER=development
DEVELOPMENT_AUTH_TOKEN=
DEVELOPMENT_ADMIN_AUTH_TOKEN=
